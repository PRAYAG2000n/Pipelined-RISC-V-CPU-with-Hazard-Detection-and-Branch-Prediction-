`timescale 1ns/1ps

module riscv_tb;

  // ------------------------------------------------------------
  // Clock & Reset
  // ------------------------------------------------------------
  reg clk;
  reg reset;

  initial begin
    clk = 1'b0;
    forever #5 clk = ~clk;  // 100 MHz
  end

  initial begin
    $display("Starting RISC-V CPU Simulation...");
    reset = 1'b1;
    #20;
    reset = 1'b0;
    $display("Reset released, starting program execution...");
  end

  // ------------------------------------------------------------
  // DUT (instance name MUST be 'uut')
  // ------------------------------------------------------------
  riscv_core uut (
    .clk   (clk),
    .reset (reset)
  );

  // ------------------------------------------------------------
  // Progress prints (PC trace every cycle)
  // ------------------------------------------------------------
  always @(posedge clk) if (!reset)
    $display("Time: %0t, PC: %08h", $time, uut.pc_if);

  // ------------------------------------------------------------
  // Hazard/flush counters (only signals we know exist)
  // ------------------------------------------------------------
  integer hazard_count, flush_count;
  initial begin
    hazard_count = 0;
    flush_count  = 0;
  end

  always @(posedge clk) begin
    if (!reset && uut.hazard_detection.stall_id) hazard_count = hazard_count + 1;
    if (!reset && uut.hazard_detection.flush_id) flush_count  = flush_count  + 1;
  end

  // Optional PC alignment warning
  always @(posedge clk) if (!reset && uut.pc_if[1:0] != 2'b00)
    $display("WARN: PC not word-aligned at %0t, pc_if=%h", $time, uut.pc_if);

  // ------------------------------------------------------------
  // End-of-run summary & finish (finite run)
  // ------------------------------------------------------------
  initial begin
    #1020;
    $display("\n--- TB Summary ---");
    $display("Hazard events : %0d", hazard_count);
    $display("Flush events  : %0d", flush_count);
    $display("------------------\n");
    $finish;
  end

// =====================================================
// Functional coverage + simple assertions (SV-only)
// Safe signals only: pc_if, stall_id, flush_id
// =====================================================

// Simple assertions (PC word alignment; flush/stall are not both 1)
always @(posedge clk) begin
  if (!reset) begin
    assert (uut.pc_if[1:0] == 2'b00)
      else $error("PC not word-aligned at %0t: %h", $time, uut.pc_if);
    assert (!(uut.hazard_detection.stall_id && uut.hazard_detection.flush_id))
      else $error("stall & flush high together @%0t", $time);
  end
end

// Functional coverage on events we can prove without fragile paths
typedef enum int {PHASE_RESET=0, PHASE_RUN=1} phase_e;
phase_e phase;

always @(posedge clk) begin
  if (reset) phase <= PHASE_RESET; else phase <= PHASE_RUN;
end

covergroup cg @(posedge clk);
  // Pipeline is running
  phase_e phase_cp;
  // PC progress (coarse bins so we don't depend on specific program)
  coverpoint uut.pc_if[9:2] { // word index
    bins low   = {[0:8]};
    bins mid   = {[9:32]};
    bins high  = {[33:255]};
  }
  // Hazards visible at least once
  coverpoint uut.hazard_detection.stall_id  { bins any_stall = {1'b1}; }
  coverpoint uut.hazard_detection.flush_id  { bins any_flush = {1'b1}; }

  // Cross: see a stall/flush while PC is in “mid/high” ranges
  cross uut.hazard_detection.stall_id, uut.pc_if[9:2];
  cross uut.hazard_detection.flush_id, uut.pc_if[9:2];

endgroup

cg covi = new;

// Print a summary line at end (does not require coverage DB)
initial begin
  @(negedge reset);
  // let your run finish; your TB already $finish’es ~1020 ns
  #1100;
  $display("Functional coverage (approx bins) = %0.2f%%", covi.get_coverage());
end
  
endmodule


